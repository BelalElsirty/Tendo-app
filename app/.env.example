# Copy to .env.local (git-ignored) or set as EAS environment variables.

# Crash reporting. Leave empty to turn Sentry off; the app works the same without it.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only, for uploading source maps. Set these in EAS (SENTRY_AUTH_TOKEN as a secret), not here.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
